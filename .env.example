# ==============================================================================
# GROWWISE PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ห้ามฝังค่าลับจริงในไฟล์นี้ หรือนำขึ้น Git repository
# ==============================================================================

# 1. Dual-Port Configuration (Local Development)
USER_PORT=3000
ADMIN_PORT=3001
NODE_ENV=development

# 2. Database Backend Selection ('mock' | 'supabase' | 'firebase')
DATA_BACKEND=mock

# 3. Supabase Configuration (เมื่อเลือกใช้งาน Supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-expose-to-browser

# 4. Firebase Configuration (เมื่อเลือกใช้งาน Firebase)
# FIREBASE_PROJECT_ID=grow-wise-platform
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@grow-wise.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."

# 5. Security & Authentication
# JWT_SECRET=your-random-high-entropy-jwt-secret-here
# PROTOTYPE_ADMIN_PASSWORD=admin0100 # ใช้เฉพาะ prototype ในเครื่องเท่านั้น ห้ามใช้บน prod
